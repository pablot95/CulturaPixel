Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dominio sin www → www (el canónico del sitio). Solo para el dominio real: el
  # dominio temporal de Hostinger sigue funcionando para probar antes de migrar el DNS.
  RewriteCond %{HTTP_HOST} ^institutoculturapixel\.com$ [NC]
  RewriteRule ^ https://www.institutoculturapixel.com%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^www\.institutoculturapixel\.com$ [NC]
  RewriteRule ^ https://www.institutoculturapixel.com%{REQUEST_URI} [R=301,L]

  # Accesos cortos
  RewriteRule ^ebooks/?$ /#ebooks [R=302,NE,L]
  RewriteRule ^quinceaneras/?$ /ebooks/quinceaneras/ [R=301,L]

  # El deploy por Git trae archivos de desarrollo que no se sirven.
  RewriteRule ^(tests|scripts|secretos|storage|node_modules)(/|$) - [F,L]
  RewriteRule ^(package(-lock)?\.json|firebase\.json|firestore\.rules|firestore\.indexes\.json|EBOOKS\.md|\.vercelignore)$ - [F,L]
  RewriteRule (^|/)\.(git|env|claude) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Las páginas se revalidan en cada visita (304 si no cambiaron). Los CSS, JS e imágenes
  # se cachean 7 días (Hostinger) pero van con ?v=<hash> (npm run versionar): un deploy
  # nunca mezcla una página nueva con archivos viejos.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
