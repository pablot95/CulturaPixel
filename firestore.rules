rules_version = '2';

// Nadie lee ni escribe Firestore desde el navegador. Las funciones de /api usan la
// cuenta de servicio (que no pasa por estas reglas) y el panel de /admin consulta todo a
// través de /api/ebooks/admin, que valida el token de Firebase Auth y admins/{email}.
// Así los tokens de Mercado Pago y los datos de los compradores nunca quedan expuestos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
